PORT=3100
APP_VERSION=0.4.3
DATA_DIR=./data
SITE_URL=http://localhost:3100
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_MIN_ACCOUNT_AGE_DAYS=30
DOWNLOAD_MAC_URL=
DOWNLOAD_WIN_URL=
STORAGE_DRIVER=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=
# Set only when behind your own reverse proxy; direct local development leaves this false.
TRUST_PROXY=false

# Backup: use local only for rehearsal; production uses a private OSS bucket.
BACKUP_DIR=./backups
BACKUP_REMOTE=local
BACKUP_OSS_REGION=
BACKUP_OSS_BUCKET=
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
BACKUP_OSS_ENDPOINT=
