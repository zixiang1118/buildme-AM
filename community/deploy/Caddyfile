{$COMMUNITY_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 10MB
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  handle_path /media/* {
    root * /var/lib/buildme-community/media
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle /assets/* {
    root * /opt/buildme-community/current/public
    uri strip_prefix /assets
    uri path_regexp \.([a-f0-9]{12})(\.[^.]+)$ $2
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle /fonts/* {
    root * /opt/buildme-community/current/public
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    reverse_proxy 127.0.0.1:3100
  }
}
