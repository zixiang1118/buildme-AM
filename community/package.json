{
  "name": "buildme-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc -p tsconfig.build.json && node --import tsx scripts/assets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "create-admin": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "test:browser": "playwright test",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "cleanup": "node --env-file-if-exists=.env --import tsx scripts/cleanup-images.ts",
    "benchmark": "node --import tsx scripts/performance.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "better-sqlite3": "^12.4.0",
    "sharp": "^0.34.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "highlight.js": "^11.11.1",
    "sanitize-html": "^2.17.0",
    "linkedom": "^0.18.12",
    "ipaddr.js": "^2.2.0",
    "ali-oss": "^6.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/ali-oss": "^6.23.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "vitest": "^4.1.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.70.0",
    "globals": "^16.4.0",
    "@playwright/test": "^1.58.0",
    "@fontsource/schibsted-grotesk": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0"
  }
}
